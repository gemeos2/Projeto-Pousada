onify-icon>\n                    </div>\n                    <h3 class=\"text-lg font-semibold text-slate-900 mb-2\">Úspora nákladů</h3>\n                    <p class=\"text-sm text-slate-500\">Optimalizace licencí a snížení hardwarových nároků.</p>\n                </div>\n                <!-- Feature 3 -->\n                <div class=\"flex flex-col items-start group hover:bg-slate-50 p-4 rounded-xl transition-colors duration-300\">\n                    <div class=\"w-10 h-10 rounded-lg bg-orange-100 flex items-center justify-center text-orange-600 mb-4 group-hover:scale-110 transition-transform duration-300\">\n                        <iconify-icon icon=\"solar:bolt-linear\" width=\"20\"></iconify-icon>\n                    </div>\n                    <h3 class=\"text-lg font-semibold text-slate-900 mb-2\">Produktivita</h3>\n                    <p class=\"text-sm text-slate-500\">Real-time spolupráce a komunikace bez hranic.</p>\n                </div>\n                <!-- Feature 4 -->\n                <div class=\"flex flex-col items-start group hover:bg-slate-50 p-4 rounded-xl transition-colors duration-300\">\n                    <div class=\"w-10 h-10 rounded-lg bg-orange-100 flex items-center justify-center text-orange-600 mb-4 group-hover:scale-110 transition-transform duration-300\">\n                        <iconify-icon icon=\"solar:shield-check-linear\" width=\"20\"></iconify-icon>\n                    </div>\n                    <h3 class=\"text-lg font-semibold text-slate-900 mb-2\">Zabezpečení</h3>\n                    <p class=\"text-sm text-slate-500\">Enterprise-grade zabezpečení vašich firemních dat.</p>\n                </div>\n                <!-- Feature 5 -->\n                <div class=\"flex flex-col items-start group hover:bg-slate-50 p-4 rounded-xl transition-colors duration-300\">\n                    <div class=\"w-10 h-10 rounded-lg bg-orange-100 flex items-center justify-center text-orange-600 mb-4 group-hover:scale-110 transition-transform duration-300\">\n                        <iconify-icon icon=\"solar:help-circle-linear\" width=\"20\"></iconify-icon>\n                    </div>\n                    <h3 class=\"text-lg font-semibold text-slate-900 mb-2\">Podpora</h3>\n                    <p class=\"text-sm text-slate-500\">Lokální česká podpora připravená kdykoliv pomoci.</p>\n                </div>\n                <!-- Feature 6 -->\n                <div class=\"flex flex-col items-start group hover:bg-slate-50 p-4 rounded-xl transition-colors duration-300\">\n                    <div class=\"w-10 h-10 rounded-lg bg-orange-100 flex items-center justify-center text-orange-600 mb-4 group-hover:scale-110 transition-transform duration-300\">\n                        <iconify-icon icon=\"solar:globe-linear\" width=\"20\"></iconify-icon>\n                    </div>\n                    <h3 class=\"text-lg font-semibold text-slate-900 mb-2\">Mobilita</h3>\n                    <p class=\"text-sm text-slate-500\">Pracujte odkudkoliv, z jakéhokoliv zařízení.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Testimonial Section (Parallax effect) -->\n    <section id=\"testimonials\" class=\"py-24 bg-slate-50 relative overflow-hidden\">\n        <div class=\"absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-20\"></div>\n        <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10\">\n            \n            <div class=\"bg-white rounded-3xl p-8 lg:p-12 border border-slate-200/60 shadow-xl flex flex-col lg:flex-row gap-12 items-center transform hover:scale-[1.01] transition-transform duration-500\">\n                <div class=\"flex-1\">\n                    <div class=\"flex text-orange-500 mb-6 gap-1\">\n                        <iconify-icon icon=\"solar:star-bold\" width=\"20\"></iconify-icon>\n                        <iconify-icon icon=\"solar:star-bold\" width=\"20\"></iconify-icon>\n            