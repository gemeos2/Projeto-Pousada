-8\">\n            <div class=\"text-center mb-12\">\n                <span class=\"px-3 py-1 rounded-full bg-orange-50 text-orange-600 text-xs font-medium border border-orange-100 uppercase tracking-wide\">FAQ</span>\n                <h2 class=\"text-3xl font-semibold tracking-tight text-slate-900 mt-4\">Časté dotazy</h2>\n            </div>\n            \n            <div class=\"space-y-4\">\n                <details class=\"group border border-slate-200 rounded-xl bg-white overflow-hidden transition-all duration-300 hover:border-orange-200 hover:shadow-sm\">\n                    <summary class=\"flex justify-between items-center p-5 cursor-pointer list-none\">\n                        <h3 class=\"text-base font-medium text-slate-900 group-hover:text-orange-600 transition-colors\">Co je MeetCloud a jak nám může pomoci?</h3>\n                        <div class=\"transition-transform duration-300 group-open:rotate-180 text-slate-400 group-hover:text-orange-500\">\n                             <iconify-icon icon=\"solar:alt-arrow-down-linear\" width=\"20\"></iconify-icon>\n                        </div>\n                    </summary>\n                    <div class=\"px-5 pb-5 text-sm text-slate-500 leading-relaxed animate-fade-in-up\">\n                        MeetCloud je certifikovaný partner Google, který pomáhá firmám s přechodem na cloudové technologie, nastavením procesů a školením zaměstnanců pro maximální efektivitu.\n                    </div>\n                </details>\n\n                <details class=\"group border border-slate-200 rounded-xl bg-white overflow-hidden transition-all duration-300 hover:border-orange-200 hover:shadow-sm\">\n                    <summary class=\"flex justify-between items-center p-5 cursor-pointer list-none\">\n                        <h3 class=\"text-base font-medium text-slate-900 group-hover:text-orange-600 transition-colors\">Jak dlouho trvá migrace dat?</h3>\n                        <div class=\"transition-transform duration-300 group-open:rotate-180 text-slate-400 group-hover:text-orange-500\">\n                             <iconify-icon icon=\"solar:alt-arrow-down-linear\" width=\"20\"></iconify-icon>\n                        </div>\n                    </summary>\n                    <div class=\"px-5 pb-5 text-sm text-slate-500 leading-relaxed animate-fade-in-up\">\n                        Délka migrace závisí na objemu dat a počtu uživatelů. U menších firem to může být otázka dní, u větších organizací několik týdnů. Vždy však zajišťujeme minimální dopad na provoz.\n                    </div>\n                </details>\n\n                 <details class=\"group border border-slate-200 rounded-xl bg-white overflow-hidden transition-all duration-300 hover:border-orange-200 hover:shadow-sm\">\n                    <summary class=\"flex justify-between items-center p-5 cursor-pointer list-none\">\n                        <h3 class=\"text-base font-medium text-slate-900 group-hover:text-orange-600 transition-colors\">Poskytujete školení v češtině?</h3>\n                        <div class=\"transition-transform duration-300 group-open:rotate-180 text-slate-400 group-hover:text-orange-500\">\n                             <iconify-icon icon=\"solar:alt-arrow-down-linear\" width=\"20\"></iconify-icon>\n                        </div>\n                    </summary>\n                    <div class=\"px-5 pb-5 text-sm text-slate-500 leading-relaxed animate-fade-in-up\">\n                        Ano, všechna školení i technická podpora probíhají kompletně v českém jazyce s našimi místními certifikovanými experty.\n                    </div>\n                </details>\n            </div>\n        </div>\n    </section>\n\n    <!-- CTA Section -->\n    <section class=\"py-20 relative overflow-hidden bg-slate-900\">\n        <div class=\"absolute inset-0 bg-gradient-to-r from-orange-600/20 to-purple-600/20 mix-blend-overlay\"></div>\n        <div class=\"max-w-4xl mx-auto px-4 text-center relative z-10\">\n            <h2 class=\"text-3xl lg:text-4xl font-semibold tracking-tight text-white mb-6\">Připraveni na digitální transformaci?</h2>\n            <p class=\"text-lg text-slate-400 mb-10 max-w-2xl mx-auto\">Posuňte svou organizaci na další úroveň s Google Workspace a našimi experty.</p>\n            <div class=\"flex justify-center gap-4\">\n                 <a href=\"#contact\" class=\"inline-flex items-center justify-center px-8 py-4 text-base font-medium text-slate-900 bg-white rounded-xl hover:bg-slate-100 transition-all duration-300 shadow-lg hover:-translate-y-1\">\n                    Kontaktovat\n                </a>\n            </div>\n        </div>\n    </section>\n\n    <!-- Contact Section -->\n    <section id=\"contact\" class=\"bg-white py-24 relative z-10\">\n        <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n            <div class=\"grid lg:grid-cols-12 gap-12 lg:gap-20\">\n                <!-- Info -->\n                <div class=\"lg:col-span-5 space-y-8\">\n                    <div>\n                        <h3 class=\"text-2xl font-semibold text-slate-900 mb-6\">Kontaktní informace</h3>\n                        <p class=\"text-slate-500 mb-8\">Jsme tu pro vás každý pracovní den. Ozvěte se nám.</p>\n                        \n                        <div class=\"space-y-6\">\n                            <a href=\"mailto:info@meetcloud.cz\" class=\"flex items-center gap-4 group p-4 rounded-xl hover:bg-slate-50 transition-colors border border-transparent hover:border-slate-100\">\n                                <div class=\"bg-white p-3 rounded-lg border border-slate-200 shadow-sm group-hover:border-orange-200 group-hover:text-orange-600 transition-colors text-slate-500\">\n                                    <iconify-icon icon=\"solar:letter-linear\" width=\"24\"></iconify-icon>\n                                </div>\n                                <div>\n                                    <p class=\"text-xs fon