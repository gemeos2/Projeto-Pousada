[{"id":18428,"slug":"guesthouse-landing-67","title":"Guesthouse Landing Page Template","code":"<!DOCTYPE html>\n<html lang=\"en\" class=\"scroll-smooth\">\n<head>\n<script>\ntry{if(window.parent&&window.parent!==window){window.parent.promotekit_referral=\"1fd2949a-d22c-431b-92bf-02d4ad04ee24\";window.parent.document.cookie=\"promotekit_referral=1fd2949a-d22c-431b-92bf-02d4ad04ee24;path=/;domain=.aura.build;max-age=31536000\"}}catch(e){}\n</script>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Penzion MATA | Peaceful Guesthouse in Zlín – Malenovice</title>\n<meta name=\"description\" content=\"Family-run guesthouse in Zlín-Malenovice offering clean ensuite rooms, free parking, and a restaurant. Just 5 mins from Zlín center. Book your stay today.\">\n<!-- Fonts: Inter for that clean, Vercel-like aesthetic -->\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n<!-- Tailwind CSS -->\n<script src=\"https://cdn.tailwindcss.com\"></script>\n<!-- Lucide Icons -->\n<script src=\"https://unpkg.com/lucide@latest\"></script>\n<script>\ntailwind.config = {\ntheme: {\nextend: {\nfontFamily: {\nsans: ['Inter', 'sans-serif'],\n},\ncolors: {\nmata: {\ngreen: '#3e4c28', // Derived from background\nolive: '#5e6e40', // Lighter green\norange: '#d9853b', // Button color\ncream: '#f5f5f0', // Content bg equivalent\nstone: '#1c1917',\n}\n}\n}\n}\n}\n</script></head>\n<body class=\"bg-stone-50 text-stone-800 antialiased font-sans selection:bg-mata-orange selection:text-white\">\n\n    <!-- Navigation -->\n    <nav class=\"fixed w-full z-50 bg-white/80 backdrop-blur-md border-b border-stone-200\">\n        <div class=\"max-w-6xl mx-auto px-6 h-16 flex items-center justify-between\">\n            <a href=\"#\" class=\"text-xl font-semibold tracking-tight text-mata-green\">\n                Penzion MATA\n            </a>\n            <div class=\"hidden md:flex items-center gap-8 text-sm font-medium text-stone-600\">\n                <a href=\"#rooms\" class=\"hover:text-mata-orange transition-colors\">Rooms</a>\n                <a href=\"#amenities\" class=\"hover:text-mata-orange transition-colors\">Amenities</a>\n                <a href=\"#location\" class=\"hover:text-mata-orange transition-colors\">Location</a>\n                <a href=\"#contact\" class=\"hover:text-mata-orange transition-colors\">Contact</a>\n            </div>\n            <a href=\"#contact\" class=\"bg-mata-orange hover:bg-orange-600 text-white text-sm font-medium px-5 py-2.5 rounded-full transition-all shadow-sm\">\n                Book your stay\n            </a>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <section class=\"relative pt-32 pb-20 md:pt-40 md:pb-32 overflow-hidden\">\n        <div class=\"max-w-6xl mx-auto px-6 grid md:grid-cols-2 gap-12 items-center\">\n            <div class=\"space-y-8\">\n                <div class=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-mata-green/10 text-mata-green text-xs font-medium uppercase tracking-wider\">\n                    <span class=\"w-2 h-2 rounded-full bg-mata-green\"></span>\n                    Open year-round\n                </div>\n                <h1 class=\"text-5xl md:text-6xl font-semibold tracking-tight text-mata-green leading-[1.1]\">\n                    A quiet haven in Zlín – Malenovice.\n                </h1>\n                <p class=\"text-xl text-stone-600 max-w-lg leading-relaxed\">\n                    Experience genuine Czech hospitality in a peaceful setting near the castle. Perfect for business travelers, couples, and families seeking comfort and convenience.\n                </p>\n                \n                <ul class=\"space-y-3 text-stone-700\">\n                    <li class=\"flex items-center gap-3\">\n                        <i data-lucide=\"check\" class=\"w-5 h-5 text-mata-orange\"></i>\n                        <span>Free private parking on-site</span>\n                    </li>\n                    <li class=\"flex items-center gap-3\">\n                        <i data-lucide=\"check\" class=\"w-5 h-5 text-mata-orange\"></i>\n                        <span>5 minutes drive to Zlín city center</span>\n                    </li>\n                    <li class=\"flex items-center gap-3\">\n                        <i data-lucide=\"check\" class=\"w-5 h-5 text-mata-orange\"></i>\n                        <span>Private restaurant & event space</span>\n                    </li>\n                </ul>\n\n                <div class=\"flex flex-col sm:flex-row gap-4 pt-4\">\n                    <a href=\"#contact\" class=\"inline-flex justify-center items-center px-6 py-3.5 bg-mata-green text-white font-medium rounded-lg hover:bg-mata-olive transition-colors shadow-sm w-full sm:w-auto\">\n                        Check availability\n                    </a>\n                    <a href=\"tel:+420725720497\" class=\"inline-flex justify-center items-center px-6 py-3.5 bg-white border border-stone-200 text-stone-700 font-medium rounded-lg hover:bg-stone-50 transition-colors w-full sm:w-auto\">\n                        <i data-lucide=\"phone\" class=\"w-4 h-4 mr-2\"></i>\n                        Call us\n                    </a>\n                </div>\n            </div>\n            \n            <!-- Hero Image Placeholder -->\n            <div class=\"relative\">\n                <div class=\"aspect-[4/3] rounded-2xl overflow-hidden bg-stone-200 shadow-xl ring-1 ring-stone-900/5\">\n                    <!-- Using a generic warm interior image as placeholder -->\n                    <img src=\"https://images.unsplash.com/photo-1590490360182-c33d57733427?q=80&w=1974&auto=format&fit=crop\" alt=\"Comfortable room interior\" class=\"w-full h-full object-cover\">\n                </div>\n                <!-- Decorative element mimicking the green theme -->\n                <div class=\"absolute -z-10 top-10 -right-10 w-full h-full bg-mata-green/5 rounded-3xl\"></div>\n            </div>\n        </div>\n    </section>\n\n    <!-- About Section -->\n    <section class=\"py-24 bg-white border-y border-stone-100\">\n        <div class=\"max-w-3xl mx-auto px-6 text-center space-y-6\">\n            <h2 class=\"text-3xl font-semibold tracking-tight text-mata-green\">Welcome to Penzion MATA</h2>\n            <p class=\"text-lg text-stone-600 leading-relaxed\">\n                Located in the quiet district of Zlín – Malenovice, our family-run guesthouse offers a respite from the city noise while keeping you connected. Whether you are visiting the nearby Gothic castle, attending a business meeting in Zlín, or simply passing through, we provide a clean, warm, and trustworthy environment for your stay.\n            </p>\n        </div>\n    </section>\n\n    <!-- Rooms Section -->\n    <section id=\"rooms\" class=\"py-24 bg-stone-50\">\n        <div class=\"max-w-6xl mx-auto px-6\">\n            <div class=\"flex flex-col md:flex-row justify-between items-end mb-12 gap-4\">\n                <div>\n                    <h2 class=\"text-3xl font-semibold tracking-tight text-stone-900\">Accommodation</h2>\n                    <p class=\"text-stone-500 mt-2 text-lg\">Clean, practical, and fully equipped.</p>\n                </div>\n            </div>\n\n            <div class=\"grid md:grid-cols-2 gap-8\">\n                <!-- Double Room Card -->\n                <div class=\"group bg-white rounded-xl overflow-hidden border border-stone-200 hover:border-mata-orange/30 transition-all hover:shadow-lg\">\n                    <div class=\"aspect-video bg-stone-100 overflow-hidden relative\">\n                         <img src=\"https://images.unsplash.com/photo-1566665797739-1674de7a421a?q=80&w=1000&auto=format&fit=crop\" alt=\"Double Room\" class=\"object-cover w-full h-full group-hover:scale-105 transition-transform duration-500\">\n                    </div>\n                    <div class=\"p-8\">\n                        <h3 class=\"text-xl font-semibold text-stone-900 mb-2\">Double Room</h3>\n                        <p class=\"text-stone-600 mb-6\">Comfortable accommodation ideal for couples or business travelers.</p>\n                        <ul class=\"space-y-3 mb-8\">\n                            <li class=\"flex items-center gap-3 text-sm text-stone-600\">\n                                <i data-lucide=\"bath\" class=\"w-4 h-4 text-mata-orange\"></i> Private bathroom\n                            </li>\n                            <li class=\"flex items-center gap-3 text-sm text-stone-600\">\n                                <i data-lucide=\"tv\" class=\"w-4 h-4 text-mata-orange\"></i> TV included\n                            </li>\n                            <li class=\"flex items-center gap-3 text-sm text-stone-600\">\n                                <i data-lucide=\"wifi\" class=\"w-4 h-4 text-mata-orange\"></i> Free Wi-Fi\n                            </li>\n                            <li class=\"flex items-center gap-3 text-sm text-stone-600\">\n                                <i data-lucide=\"snowflake\" class=\"w-4 h-4 text-mata-orange\"></i> Refrigerator\n                            </li>\n                        </ul>\n                    </div>\n                </div>\n\n                <!-- Apartment Card -->\n                <div class=\"group bg-white rounded-xl overflow-hidden border border-stone-200 hover:border-mata-orange/30 transition-all hover:shadow-lg\">\n                    <div class=\"aspect-video bg-stone-100 overflow-hidden relative\">\n                        <img src=\"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/917d6f93-fb36-439a-8c48-884b67b35381_1600w.jpg\" alt=\"Apartment\" class=\"object-cover w-full h-full group-hover:scale-105 transition-transform duration-500\">\n                    </div>\n                    <div class=\"p-8\">\n                        <h3 class=\"text-xl font-semibold text-stone-900 mb-2\">Apartment Suite</h3>\n                        <p class=\"text-stone-600 mb-6\">More space for small families or longer stays. Includes a fixed extra bed option.</p>\n                        <ul class=\"space-y-3 mb-8\">\n                            <li class=\"flex items-center gap-3 text-sm text-stone-600\">\n                                <i data-lucide=\"users\" class=\"w-4 h-4 text-mata-orange\"></i> Sleeps up to 3 guests\n                            </li>\n                            <li class=\"flex items-center gap-3 text-sm text-stone-600\">\n                                <i data-lucide=\"bath\" class=\"w-4 h-4 text-mata-orange\"></i> Private bathroom\n                            </li>\n                            <li class=\"flex items-center gap-3 text-sm text-stone-600\">\n                                <i data-lucide=\"wifi\" class=\"w-4 h-4 text-mata-orange\"></i> Free Wi-Fi\n                            </li>\n                            <li class=\"flex items-center gap-3 text-sm text-stone-600\">\n                                <i data-lucide=\"layout-grid\" class=\"w-4 h-4 text-mata-orange\"></i> Enhanced living space\n                            </li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n            \n            <div class=\"mt-8 text-center\">\n                <p class=\"text-stone-500 text-sm\">Long-term stay discounts may be available upon agreement.</p>\n            </div>\n        </div>\n    </section>\n\n    <!-- Amenities Grid -->\n    <section id=\"amenities\" class=\"py-24 bg-white border-y border-stone-100\">\n        <div class=\"max-w-6xl mx-auto px-6\">\n             <div class=\"mb-12\">\n                <h2 class=\"text-3xl font-semibold tracking-tight text-mata-green\">Everything you need</h2>\n            </div>\n            \n            <div class=\"grid grid-cols-2 md:grid-cols-4 gap-8\">\n                <div class=\"flex flex-col gap-4 p-6 bg-stone-50 rounded-xl\">\n                    <i data-lucide=\"car\" class=\"w-8 h-8 text-mata-orange stroke-1.5\"></i>\n                    <h3 class=\"font-medium text-stone-900\">Free Parking</h3>\n                    <p class=\"text-sm text-stone-500\">Secure parking directly in front of the guesthouse.</p>\n                </div>\n                <div class=\"flex flex-col gap-4 p-6 bg-stone-50 rounded-xl\">\n                    <i data-lucide=\"utensils\" class=\"w-8 h-8 text-mata-orange stroke-1.5\"></i>\n                    <h3 class=\"font-medium text-stone-900\">On-site Restaurant</h3>\n                    <p class=\"text-sm text-stone-500\">Convenient dining available without leaving the property.</p>\n                </div>\n                <div class=\"flex flex-col gap-4 p-6 bg-stone-50 rounded-xl\">\n                    <i data-lucide=\"trophy\" class=\"w-8 h-8 text-mata-orange stroke-1.5\"></i>\n                    <h3 class=\"font-medium text-stone-900\">Tennis Court</h3>\n                    <p class=\"text-sm text-stone-500\">Active relaxation available on our private court.</p>\n                </div>\n                <div class=\"flex flex-col gap-4 p-6 bg-stone-50 rounded-xl\">\n                    <i data-lucide=\"party-popper\" class=\"w-8 h-8 text-mata-orange stroke-1.5\"></i>\n                    <h3 class=\"font-medium text-stone-900\">Events & Trainings</h3>\n                    <p class=\"text-sm text-stone-500\">Facilities suitable for celebrations and small company events.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Location Section -->\n    <section id=\"location\" class=\"py-24 bg-stone-50\">\n        <div class=\"max-w-6xl mx-auto px-6 grid md:grid-cols-2 gap-16\">\n            <div class=\"space-y-8\">\n                <h2 class=\"text-3xl font-semibold tracking-tight text-stone-900\">Location & Transport</h2>\n                <p class=\"text-lg text-stone-600\">\n                    We are situated in a quiet residential area, yet incredibly connected. The historic Malenovice Castle is just a short walk away.\n                </p>\n                \n                <div class=\"space-y-6\">\n                    <div class=\"flex gap-4\">\n                        <div class=\"flex-shrink-0 w-10 h-10 rounded-full bg-mata-orange/10 flex items-center justify-center text-mata-orange\">\n                            <i data-lucide=\"bus\" class=\"w-5 h-5\"></i>\n                        </div>\n                        <div>\n                            <h4 class=\"font-medium text-stone-900\">Public Transport</h4>\n                            <p class=\"text-stone-600 mt-1\">Train stop: ~100m. Bus stop: ~150m. Easy access to Zlín without a car.</p>\n                        </div>\n                    </div>\n                    <div class=\"flex gap-4\">\n                        <div class=\"flex-shrink-0 w-10 h-10 rounded-full bg-mata-orange/10 flex items-center justify-center text-mata-orange\">\n                            <i data-lucide=\"map-pin\" class=\"w-5 h-5\"></i>\n                        </div>\n                        <div>\n                            <h4 class=\"font-medium text-stone-900\">Nearby Highlights</h4>\n                            <ul class=\"text-stone-600 mt-1 space-y-1 text-sm\">\n                                <li>• Malenovice Castle (~500m)</li>\n                                <li>• Zlín \"Skyscraper\" Baťa Building (~4.5km)</li>\n                                <li>• Shoe Museum (~4.8km)</li>\n                            </ul>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            \n            <div class=\"bg-stone-200 rounded-2xl h-full min-h-[300px] flex items-center justify-center relative overflow-hidden\">\n                <!-- Decorative map placeholder -->\n                <div class=\"absolute inset-0 opacity-50 bg-[url('https://upload.wikimedia.org/wikipedia/commons/thumb/e/ec/Zl%C3%ADn%2C_Malenovice_-_hrad_%2801%29.jpg/640px-Zl%C3%ADn%2C_Malenovice_-_hrad_%2801%29.jpg')] bg-cover bg-center\"></div>\n                <div class=\"relative bg-white p-6 rounded-lg shadow-xl max-w-xs text-center\">\n                    <p class=\"font-semibold text-stone-900\">Penzion MATA</p>\n                    <p class=\"text-sm text-stone-500 mt-1\">Ireny Veselkové 270<br>763 02 Zlín – Malenovice</p>\n                    <a href=\"https://www.google.com/maps/search/?api=1&query=49.208426,17.599219\" target=\"_blank\" class=\"text-xs text-mata-orange font-medium mt-3 inline-block hover:underline\">View on Google Maps &rarr;</a>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Guest Reviews -->\n    <section class=\"py-24 bg-white border-y border-stone-100\">\n        <div class=\"max-w-4xl mx-auto px-6 text-center\">\n            <h2 class=\"text-2xl font-semibold tracking-tight text-stone-900 mb-12\">What our guests say</h2>\n            <div class=\"grid md:grid-cols-2 gap-8\">\n                <div class=\"p-6 rounded-2xl bg-stone-50 text-left\">\n                    <div class=\"flex text-mata-orange mb-4\">\n                        <i data-lucide=\"star\" class=\"w-4 h-4 fill-current\"></i>\n                        <i data-lucide=\"star\" class=\"w-4 h-4 fill-current\"></i>\n                        <i data-lucide=\"star\" class=\"w-4 h-4 fill-current\"></i>\n                        <i data-lucide=\"star\" class=\"w-4 h-4 fill-current\"></i>\n                        <i data-lucide=\"star\" class=\"w-4 h-4 fill-current\"></i>\n                    </div>\n                    <p class=\"text-stone-700 italic\">\"The rooms were impeccably clean and the host was incredibly friendly. It's a great value stay near Zlín.\"</p>\n                </div>\n                <div class=\"p-6 rounded-2xl bg-stone-50 text-left\">\n                    <div class=\"flex text-mata-orange mb-4\">\n                        <i data-lucide=\"star\" class=\"w-4 h-4 fill-current\"></i>\n                        <i data-lucide=\"star\" class=\"w-4 h-4 fill-current\"></i>\n                        <i data-lucide=\"star\" class=\"w-4 h-4 fill-current\"></i>\n                        <i data-lucide=\"star\" class=\"w-4 h-4 fill-current\"></i>\n                        <i data-lucide=\"star\" class=\"w-4 h-4 fill-current\"></i>\n                    </div>\n                    <p class=\"text-stone-700 italic\">\"Very practical location with the train stop so close. The private parking was a huge bonus for us.\"</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- FAQ Section -->\n    <section class=\"py-24 bg-stone-50\">\n        <div class=\"max-w-3xl mx-auto px-6\">\n            <h2 class=\"text-3xl font-semibold tracking-tight text-stone-900 mb-10\">Frequently Asked Questions</h2>\n            \n            <div class=\"space-y-4\">\n                <div class=\"bg-white p-6 rounded-xl border border-stone-200\">\n                    <h3 class=\"font-medium text-stone-900 mb-2\">What are the check-in and check-out times?</h3>\n                    <p class=\"text-stone-600 text-sm\">Check-in is available from 14:00. Check-out is strictly by 10:00 to allow us to prepare for the next guests.</p>\n                </div>\n                \n                <div class=\"bg-white p-6 rounded-xl border border-stone-200\">\n                    <h3 class=\"font-medium text-stone-900 mb-2\">Are pets allowed?</h3>\n                    <p class=\"text-stone-600 text-sm\">We maintain an allergen-free environment, so pets are unfortunately not allowed.</p>\n                </div>\n                \n                <div class=\"bg-white p-6 rounded-xl border border-stone-200\">\n                    <h3 class=\"font-medium text-stone-900 mb-2\">Which payment cards do you accept?</h3>\n                    <p class=\"text-stone-600 text-sm\">We accept VISA, VISA Electron, MasterCard, MasterCard Electron, Diners Club, and JCB.</p>\n                </div>\n\n                <div class=\"bg-white p-6 rounded-xl border border-stone-200\">\n                    <h3 class=\"font-medium text-stone-900 mb-2\">How do I book?</h3>\n                    <p class=\"text-stone-600 text-sm\">The best way is to call us directly or send an email to confirm availability for your dates.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Contact / Footer -->\n    <section id=\"contact\" class=\"bg-mata-green text-mata-cream py-24\">\n        <div class=\"max-w-6xl mx-auto px-6 grid md:grid-cols-2 gap-16\">\n            <div>\n                <h2 class=\"text-4xl font-semibold tracking-tight mb-6\">Ready to visit Zlín?</h2>\n                <p class=\"text-mata-cream/80 text-lg mb-8 max-w-md\">\n                    Contact us to book your room or ask any questions about your stay. We look forward to welcoming you.\n                </p>\n                \n                <div class=\"space-y-6\">\n                    <a href=\"tel:+420725720497\" class=\"flex items-center gap-4 text-xl font-medium hover:text-white transition-colors\">\n                        <i data-lucide=\"phone\" class=\"w-6 h-6 text-mata-orange\"></i>\n                        +420 725 720 497\n                    </a>\n                    <a href=\"mailto:penzionmata@seznam.cz\" class=\"flex items-center gap-4 text-xl font-medium hover:text-white transition-colors\">\n                        <i data-lucide=\"mail\" class=\"w-6 h-6 text-mata-orange\"></i>\n                        penzionmata@seznam.cz\n                    </a>\n                    <div class=\"flex items-start gap-4 text-lg text-mata-cream/80\">\n                        <i data-lucide=\"map-pin\" class=\"w-6 h-6 text-mata-orange mt-1\"></i>\n                        <span>\n                            Ireny Veselkové 270<br>\n                            763 02 Zlín – Malenovice<br>\n                            Czech Republic\n                        </span>\n                    </div>\n                </div>\n\n                <div class=\"mt-12 pt-12 border-t border-mata-cream/10 text-sm text-mata-cream/50\">\n                    <p>&copy; 2024 Penzion MATA. All rights reserved.</p>\n                    <p class=\"mt-2\">GPS: 49°12'30.336\"N, 17°35'57.191\"E</p>\n                </div>\n            </div>\n\n            <div class=\"bg-mata-olive/20 p-8 rounded-2xl border border-mata-cream/10 h-fit\">\n                <h3 class=\"text-xl font-semibold mb-6\">Reservation Inquiry</h3>\n                <p class=\"text-mata-cream/70 mb-6 text-sm\">Alternative contact number: <span class=\"text-white\">+420 577 102 850</span></p>\n                \n                <div class=\"space-y-4\">\n                    <p class=\"text-sm text-mata-cream/70\">Please call or email us directly for the fastest reservation confirmation.</p>\n                    <a href=\"mailto:penzionmata@seznam.cz?subject=Booking Inquiry\" class=\"block w-full text-center py-4 bg-mata-orange text-white font-semibold rounded-lg hover:bg-orange-600 transition-colors\">\n                        Send Email Inquiry\n                    </a>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- SEO & Metadata Block (Hidden from view, intended for developer implementation) -->\n    <!-- \n    PAGE SEO PACKAGE:\n    \n    1. Title Tag (Max ~60 chars):\n       Penzion MATA | Comfortable Guesthouse in Zlín – Malenovice\n       \n    2. Meta Description (Max ~155 chars):\n       Stay at Penzion MATA in Zlín-Malenovice. Family-run guesthouse with ensuite rooms, restaurant, and free parking. 5 mins from city center. Book now.\n       \n    3. Heading Structure:\n       H1: A quiet haven in Zlín – Malenovice.\n       H2: Welcome to Penzion MATA\n       H2: Accommodation (Rooms)\n       H2: Everything you need (Amenities)\n       H2: Location & Transport\n       H2: What our guests say\n       H2: Frequently Asked Questions\n       H2: Ready to visit Zlín? (Contact)\n       \n    4. Keywords (English & Czech):\n       accommodation Zlín Malenovice, guesthouse Zlín, ubytování Zlín, penzion Malenovice, rooms near Zlín castle, bed and breakfast Zlín, Penzion MATA reservation, business stay Zlín, holiday apartments Zlín.\n    -->\n\n    <script>\n        lucide.createIcons();\n    </script>\n</body>\n</html>","language":"html","username":"ee9c4aba-23fa-4f0f-ad0d-94edc27e6978","created_at":"2026-02-07T15:25:47.622962+00:00","views":66,"image_url":"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/preview-images/guesthouse-landing-67.png","forks":0,"private":false,"watermark":true,"featured":true,"share_source_code":true,"user_id":"ee9c4aba-23fa-4f0f-ad0d-94edc27e6978","category":"Web","updated_at":null,"tags":["Landing Page","Travel","Services","Brand","Clean","Minimal","Large Type","Gradient","Guesthouse","Hotel"],"description":"A reusable guesthouse landing page template for showcasing rooms, amenities, location, reviews, and contact details for small hotels and family-run pensions.","premium":false,"price":null,"purchase_url":null,"long_description":"## **Guesthouse Landing Page Template**\n\nA modern, Inter/Tailwind-powered template crafted for small hotels, pensions, and family-run guesthouses to present their offering clearly and convert visitors.\n\n**Key features**\n- **Hero section** with value props, social-proof style highlights, and primary booking CTAs\n- **Rooms/Accommodation layout** featuring image cards, amenities icons, and stay details\n- **Amenities & Location blocks** with transport info, nearby highlights, and map-style callout\n- **Guest reviews & FAQ** sections to address objections and build trust\n- **Contact & reservation area** optimized for phone and email inquiries\n\n**Use case**\nIdeal for owners who need a clean, mobile-ready site to showcase rooms, amenities, and location while driving direct bookings via phone, email, or simple inquiry links.","custom_domain":null,"favicon_light_url":null,"favicon_dark_url":null,"dns_verified":null,"dns_verified_at":null,"dns_a_record":null,"netlify_apex_exists":null,"netlify_www_exists":null,"netlify_verified_at":null,"custom_domain_added_at":null,"netlify_site_id":null,"umami_website_id":null,"umami_share_id":null,"analytics_enabled":false,"gtm_container_id":null,"remix_source":{},"credit_remix_source":false,"search_visibility":"aura_and_custom_domain","llms_txt":null,"llms_txt_updated_at":null,"featured_at":"2026-02-07T15:25:47.622962+00:00","google_analytics_id":null,"source_revision_id":null,"published_storage_prefix":null}]