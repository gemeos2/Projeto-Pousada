oader\">\n    <div class=\"mk\">AETHER</div>\n    <div class=\"bar\"><i id=\"lbar\"></i></div>\n  </div>\n\n  <nav>\n    <div class=\"wm\">AETHER</div>\n    <div class=\"menu\"><a href=\"#material\">Work</a><a href=\"#studio\">Studio</a><a href=\"#inquire\">Contact</a></div>\n  </nav>\n\n  <!-- FLYTHROUGH: scroll-scrubbed cinematic sequence (approach -> interior -> void -> dusk) -->\n  <section id=\"fly\">\n    <div class=\"layer\" id=\"L0\"><img src=\"https://cdn.jsdelivr.net/gh/VanhDc/aura-assets@aether-v2/aether/img/hero.jpg\" alt=\"The residence in the forest\">\n    </div>\n    <div class=\"layer\" id=\"L1\"><img src=\"https://cdn.jsdelivr.net/gh/VanhDc/aura-assets@aether-v2/aether/img/living.jpg\" alt=\"The living space\">\n    </div>\n    <div class=\"layer\" id=\"L2\"><img src=\"https://cdn.jsdelivr.net/gh/VanhDc/aura-assets@aether-v2/aether/img/void.jpg\" alt=\"The concrete stair void\">\n    </div>\n    <div class=\"layer\" id=\"L3\"><img src=\"https://cdn.jsdelivr.net/gh/VanhDc/aura-assets@aether-v2/aether/img/dusk.jpg\" alt=\"The residence at dusk\">\n    </div>\n    <h1 id=\"title\"><span class=\"k\">AETHER · Architecture</span><span class=\"b\">Light,<br>given form.</span></h1>\n    <div class=\"cap\" id=\"C1\">\n      <div class=\"t serif\">Inside, the forest stays.</div>\n    </div>\n    <div class=\"cap\" id=\"C2\">\n      <div class=\"t serif\">Light falls through concrete.</div>\n    </div>\n    <div class=\"cap\" id=\"C3\">\n      <div class=\"t serif\">And by dusk, it glows.</div>\n    </div>\n    <div class=\"scrollcue\"><span>Scroll</span><span class=\"ln\"></span></div>\n  </section>\n\n  <!-- MANIFESTO -->\n  <section class=\"manifesto wrap\">\n    <span class=\"eyebrow\" data-rv>The studio</span>\n    <p class=\"big\" data-rv>We do not decorate space.<br>We compose <em>light, mass and silence.</em></p>\n  </section>\n\n  <!-- MATERIAL -->\n  <section class=\"material wrap\" id=\"material\">\n    <div class=\"split\">\n      <div class=\"media\" data-rv><img src=\"https://cdn.jsdelivr.net/gh/VanhDc/aura-assets@aether-v2/aether/img/material.jpg\" alt=\"Board-formed concrete, glass and oak\">\n      </div>\n      <div class=\"copy\">\n        <span class=\"eyebrow\" data-rv>Material</span>\n        <h2 class=\"serif\" data-rv>Board-formed concrete, and nothing it does not need.</h2>\n        <p data-rv>Each wall carries the grain of the timber it was cast against. Glass meets stone without a frame. Oak\n          warms the hand where concrete cools the eye.</p>\n        <div class=\"meta\" data-rv>\n          <div>\n            <div class=\"v serif num\" data-count=\"3\">0</div>\n            <div class=\"l\">materials, honestly used</div>\n          </div>\n          <div>\n            <div class=\"v serif\">0</div>\n            <div class=\"l\">applied ornament</div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- STUDIO / DATA -->\n  <section class=\"studio wrap\" id=\"studio\">\n    <div class=\"studio-top\">\n      <div class=\"head\">\n        <span class=\"eyebrow\" data-rv>The practice</span>\n        <h2 class=\"serif\" data-rv>A small studio that builds slowly, on purpose.</h2>\n        <p class=\"lede\" data-rv>Two partners, six hands. One project at a time, drawn and modelled until the light falls\n          right, long before a wall is ever poured.</p>\n      </div>\n      <div class=\"studio-media\" data-rv>\n        <img src=\"https://cdn.jsdelivr.net/gh/VanhDc/aura-assets@aether-v2/aether/img/practice.jpg\" alt=\"A working scale model of the residence on the studio table\">\n        <span class=\"cap\">Working model · 1:50</span>\n      </div>\n    </div>\n    <div class=\"grid\">\n      <div data-rv>\n        <div class=\"v serif num\" data-count=\"2011\">0</div>\n        <div class=\"l\">Founded</div>\n      </div>\n      <div data-rv>\n        <div class=\"v serif num\" data-count=\"1240\"><span class=\"cv\">0</span><em> m²</em></div>\n        <div class=\"l\">This residence</div>\n      </div>\n      <div data-rv>\n        <div class=\"v serif num\" data-count=\"7\">0</div>\n        <div class=\"l\">International awards</div>\n      </div>\n    </div>\n  </section>\n\n  <!-- INQUIRE -->\n  <section class=\"inquire wrap\" id=\"inquire\">\n    <span class=\"eyebrow\" data-rv>Enquire</span>\n    <h2 class=\"serif\" data-rv>Request the monograph.</h2>\n    <p data-rv>A printed study of the residence, its drawings and its making. Sent to a considered few each season.</p>\n    <form class=\"signup\" data-rv onsubmit=\"return false\">\n      <input type=\"email\" placeholder=\"you@studio.com\" aria-label=\"Email\"><button type=\"submit\">Request</button></form>\n  </section>\n\n  <footer>\n    <span class=\"wm\">AETHER</span>\n    <span>Architecture · Geneva</span>\n    <span>© 2026 AETHER. Light, given form.</span>\n  </footer>\n\n  <script>\n    (function(){\n  const REDUCED = matchMedia('(prefers-reduced-motion: reduce)').matches;\n  const loader=document.getElementById('loader'), lbar=document.getElementById('lbar');\n  const imgs=[...document.images]; let n=0;\n  const done=()=>{ n++; if(lbar)lbar.style.width=Math.round(n/Math.max(1,imgs.length)*100)+'%'; if(n>=imgs.length) fin(); };\n  let f=false; function fin(){ if(f)return; f=true; setTimeout(()=>{loader.classList.add('done'); start();},250); }\n  imgs.forEach(i=> i.complete?done():(i.addEventListener('load',done),i.addEventListener('error',done)));\n  setTimeout(fin, 6000);\n\n  function start(){\n    if(!window.gsap){ document.querySelectorAll('.rv,[data-rv]').forEach(e=>{e.style.opacity=1;e.style.transform='none';}); return; }\n    gsap.registerPlugin(ScrollTrigger);\n    const lenis = (!REDUCED && window.Lenis) ? new Lenis({lerp:0.08, smoothWheel:true}) : null;\n    if(lenis){ lenis.on('scroll', ScrollTrigger.update); gsap.ticker.add(t=>lenis.raf(t*1000)); gsap.ticker.lagSmoothing(0); }\n    document.querySelectorAll('a[href^=\"#\"]').forEach(a=>a.addEventListener('click',e=>{const t=document.querySelector(a.getAttribute('href'));if(!t)return;e.preventDefault();lenis?lenis.scrollTo(t,{duration:1.4}):t.scrollIntoView({behavior:'smooth'});}));\n\n    // nav contrast: bone over the dark hero/studio/footer, flip to ink over the light sections (no backdrop bar)\n    const navEl=document.querySelector('nav');\n    const lightSecs=[...document.querySelectorAll('.manifesto,.material,.inquire')];\n    function navSpy(){ const y=46; let light=false; for(const s of lightSecs){ const r=s.getBoundingClientRect(); if(r.top<=y && r.bottom>=y){ light=true; break; } } navEl.classList.toggle('on-light',light); }\n    navSpy(); window.addEventListener('scroll',navSpy,{passive:true}); if(lenis) lenis.on('scroll',navSpy);\n\n    if(REDUCED){\n      document.querySelectorAll('[data-count]').forEach(el=>{const t=+el.getAttribute('data-count');const cv=el.querySelector('.cv');(cv||el).textContent=t.toLocaleString();});\n      document.querySelectorAll('.rv,[data-rv]').forEach(e=>{e.style.opacity=1;e.style.transform='none';});\n      return;\n    }\n\n    // FLYTHROUGH: pinned scrub crossfading + pushing through 4 layers\n    gsap.set('#L0',{opacity:1, scale:1.04});\n    gsap.set('#title',{opacity:1, y:0});\n    // one-time cold-open entrance (title is visible at rest, then lifts away on scroll)\n    gsap.from('#title .k',{opacity:0,y:24,duration:1,delay:.2,ease:'power3.out'});\n    gsap.from('#title .b',{opacity:0,y:48,duration:1.3,delay:.35,ease:'power3.out'});\n    gsap.fromTo('.scrollcue',{opacity:0},{opacity:1,duration:1,delay:1.1});\n    const tl=gsap.timeline({scrollTrigger:{trigger:'#fly', start:'top top', end:'+=360%', scrub:true, pin:true, anticipatePin:1}});\n    // title holds at rest, lifts away as the push-in begins\n    tl.to('#L0',{scale:1.18,duration:2,ease:'none'},0)\n      .to('#title',{opacity:0,y:-34,duration:.6,ease:'power1.in'},0.5)\n      .to('.scrollcue',{opacity:0,duration:.3,ease:'none'},0.25)\n      // L0 -> L1\n      .to('#L0',{opacity:0,duration:.7},1.4)\n      .fromTo('#L1',{opacity:0,scale:1.16},{opacity:1,scale:1.02,duration:.9,ease:'none'},1.3)\n      .fromTo('#C1 .t',{opacity:0,y:24},{opacity:1,y:0,duration:.4},1.7).to('#C1 .t',{opacity:0,duration:.3},2.5)\n      // L1 -> L2\n      .to('#L1',{opacity:0,scale:1.12,duration:.7},2.5)\n      .fromTo('#L2',{opacity:0,scale:1.16},{opacity:1,scale:1.02,duration:.9,ease:'none'},2.4)\n      .fromTo('#C2 .t',{opacity:0,y:24},{opacity:1,y:0,duration:.4},2.8).to('#C2 .t',{opacity:0,duration:.3},3.5)\n      // L2 -> L3\n      .to('#L2',{opacity:0,scale:1.12,duration:.7},3.5)\n      .fromTo('#L3',{opacity:0,scale:1.16},{opacity:1,scale:1.04,duration:1.1,ease:'none'},3.4)\n      .fromTo('#C3 .t',{opacity:0,y:24},{opacity:1,y:0,duration:.4},3.9);\n\n    // reveals\n    gsap.utils.toArray('[data-rv]').forEach(el=>gsap.fromTo(el,{opacity:0,y:44},{opacity:1,y:0,duration:1.15,ease:'power3.out',scrollTrigger:{trigger:el,start:'top 86%'}}));\n\n    // studio model image: slow parallax drift\n    const sm=document.querySelector('.studio-media img');\n    if(sm) gsap.fromTo(sm,{yPercent:-8},{yPercent:8,ease:'none',scrollTrigger:{trigger:'.studio-media',start:'top bottom',end:'bottom top',scrub:true}});\n\n    // count-ups\n    gsap.utils.toArray('[data-count]').forEach(el=>{\n      const target=+el.getAttribute('data-count'), cv=el.querySelector('.cv'), node=cv||el, o={v:0};\n      ScrollTrigger.create({trigger:el,start:'top 85%',once:true,onEnter:()=>gsap.to(o,{v:target,duration:1.7,ease:'power2.out',onUpdate:()=>node.textContent=Math.round(o.v).toLocaleString()})});\n    });\n\n    setTimeout(()=>ScrollTrigger.refresh(),300);\n  }\n})();\n  </script>\n</body>\n\n</html>","private":false,"user_id":"1a62ed4c-6d0d-4900-8de2-1f3139579949","share_source_code":true}]