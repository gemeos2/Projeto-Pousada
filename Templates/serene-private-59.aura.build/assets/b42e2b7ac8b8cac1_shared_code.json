,false,0,0);\n    const uT=gl.getUniformLocation(prog,'t'), uR=gl.getUniformLocation(prog,'r');\n    gl.enable(gl.BLEND);gl.blendFunc(gl.SRC_ALPHA,gl.ONE);\n    function size(){ const w=canvas.clientWidth||canvas.offsetWidth, h=canvas.clientHeight||canvas.offsetHeight; const s=0.5; canvas.width=Math.max(2,Math.floor(w*s)); canvas.height=Math.max(2,Math.floor(h*s)); gl.viewport(0,0,canvas.width,canvas.height); }\n    size(); addEventListener('resize',size);\n    let active=false, raf=0, t0=null;\n    function frame(ts){ if(!active)return; if(t0===null)t0=ts; gl.uniform1f(uT,(ts-t0)/1000); gl.uniform2f(uR,canvas.width,canvas.height); gl.drawArrays(gl.TRIANGLES,0,3); raf=requestAnimationFrame(frame); }\n    const io=new IntersectionObserver(es=>{ es.forEach(e=>{ if(e.isIntersecting && !RM){ if(!active){active=true;t0=null;raf=requestAnimationFrame(frame);} } else { active=false; cancelAnimationFrame(raf);} }); },{threshold:0.02});\n    io.observe(canvas);\n    return true;\n  }\n\n  function start(){\n    try{ makeCaustics($('#causHero')); makeCaustics($('#causWater')); }catch(e){}\n\n    if(!window.gsap){ $$('.rv,.wipe').forEach(e=>{e.style.opacity=1;e.style.transform='none';}); $$('[data-count]').forEach(e=>{}); return; }\n    gsap.registerPlugin(ScrollTrigger);\n    let lenis=null;\n    if(!RM && window.Lenis){ lenis=new Lenis({lerp:.09,smoothWheel:true});\n      lenis.on('scroll',ScrollTrigger.update); gsap.ticker.add(t=>lenis.raf(t*1000)); gsap.ticker.lagSmoothing(0); }\n    $$('a[href^=\"#\"]').forEach(a=>a.addEventListener('click',e=>{const t=document.querySelector(a.getAttribute('href'));if(!t)return;e.preventDefault();lenis?lenis.scrollTo(t,{duration:1.4}):t.scrollIntoView({behavior:'smooth'});}));\n\n    /* nav contrast: ink over light sections, bone (+shadow) over images/dark sections (no backdrop bar) */\n    const navEl=$('nav');\n    const lightSecs=$$('.intro,#villa,.vtypes,#reef,.exp,.house');\n    function navSpy(){ const y=46; let light=false; for(const s of lightSecs){ const r=s.getBoundingClientRect(); if(r.top<=y && r.bottom>=y){ light=true; break; } } navEl.classList.toggle('on-light',light); }\n    navSpy(); window.addEventListener('scroll',navSpy,{passive:true}); if(lenis) lenis.on('scroll',navSpy);\n\n    /* hero entrance */\n    if(!RM){\n      gsap.from('.open .ct .eyebrow',{opacity:0,y:18,duration:1,delay:.15,ease:'power3.out'});\n      gsap.from('.open h1 .ln > span',{yPercent:115,duration:1.25,delay:.3,ease:'power4.out',stagger:.12});\n      gsap.from('.open .sub',{opacity:0,y:18,duration:1,delay:.7,ease:'power3.out'});\n      gsap.to('.open .bg img',{yPercent:8,scale:1.12,ease:'none',scrollTrigger:{trigger:'.open',start:'top top',end:'bottom top',scrub:true}});\n    } else {\n      $$('.open h1 .ln > span').forEach(s=>s.style.transform='none');\n    }\n\n    /* generic parallax on full-bleed / feature images */\n    if(!RM){\n      $$('.par').forEach(img=>{\n        const host=img.closest('.bleed,.reserve,.feat,.vt')||img.parentElement;\n        gsap.fromTo(img,{yPercent:-8},{yPercent:8,ease:'none',scrollTrigger:{trigger:host,start:'top bottom',end:'bottom top',scrub:true}});\n      });\n    }\n\n    /* reveals */\n    $$('.rv').forEach(el=>{ if(el.closest('.open')) return; gsap.fromTo(el,{opacity:0,y:26},{opacity:1,y:0,duration:1,ease:'power3.out',scrollTrigger:{trigger:el,start:'top 88%'}}); });\n    /* wipe-rise headings */\n    $$('.wipe').forEach(el=>{ gsap.fromTo(el,{opacity:0,clipPath:'inset(0 0 100% 0)',y:10},{opacity:1,clipPath:'inset(0 0 -5% 0)',y:0,duration:1.1,ease:'power3.out',scrollTrigger:{trigger:el,start:'top 86%'}}); });\n    /* intro rule draw */\n    gsap.to('#introRule',{scaleY:1,duration:1.1,ease:'power2.out',scrollTrigger:{trigger:'#introRule',start:'top 92%'}});\n\n    /* cinematic 'one day' crossfade (pinned vertical scrub, desktop) */\n    const film=$('#gallery');\n    if(film && !RM && matchMedia('(min-width:681px)').matches){\n      const frames=$$('.frame',film), N=frames.length;\n      const meta=[['06:00','First light'],['11:00','Midday, suspended'],['14:00','Beneath'],['18:30','The blue hour'],['19:30','Sundown'],['22:00','And then, stars']];\n      const tEl=$('.film-clock .time',film), lEl=$('.film-clock .label',film), pEl=$('#filmProg'), dots=$$('.film-dots b',film);\n      let cur=-1;\n      function render(p){\n        const seg=p*(N-1), idx=Math.max(0,Math.min(N-1,Math.round(seg)));\n        frames.forEach((f,i)=>{ f.style.opacity=Math.max(0,1-Math.abs(seg-i)); });\n        const z=(1.06+0.10*p).toFixed(4); frames.forEach(f=>f.style.transform='scale('+z+')');\n        if(pEl)pEl.style.width=(p*100)+'%';\n        if(idx!==cur){ cur=idx; if(tEl)tEl.textContent=meta[idx][0]; if(lEl)lEl.textContent=meta[idx][1]; dots.forEach((d,i)=>d.classList.toggle('on',i===idx)); }\n      }\n      render(0);\n      ScrollTrigger.create({trigger:'#gallery',start:'top top',end:'+=420%',pin:true,scrub:true,anticipatePin:1,invalidateOnRefresh:true,onUpdate:s=>render(s.progress)});\n    }\n\n    /* count-ups */\n    $$('[data-count]').forEach(el=>{\n      const target=parseFloat(el.getAttribute('data-count'));\n      const render=v=>el.textContent=Math.round(v).toLocaleString();\n      if(RM){ render(target); return; }\n      render(0); const o={v:0};\n      ScrollTrigger.create({trigger:el,start:'top 92%',once:true,onEnter:()=>gsap.to(o,{v:target,duration:1.7,ease:'power2.out',onUpdate:()=>render(o.v)})});\n    });\n\n\n    setTimeout(()=>ScrollTrigger.refresh(),400);\n  }\n})();\n</script>\n</body>\n</html>\n","language":"html","username":"1a62ed4c-6d0d-4900-8de2-1f3139579949","created_at":"2026-07-02T03:29:16.678+00:00","views":2851,"image_url":"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/preview-images/serene-private-59.png","forks":49,"private":false,"watermark":true,"featured":true,"share_source_code":true,"user_id":"1a62ed4c-6d0d-4900-8de2-1f3139579949","category":"Animation","updated_at":null,"tags":["Landing Page","Technology","Brand","Clean","Dark","Animated","Minimal","Professional"],"description":"A high-end, immersive resort template featuring smooth scroll-driven animations and cinematic visuals designed for boutique hotels and private islands.","premium":true,"price":null,"purchase_url":null,"long_description":"## Overview\n**SERENE** is a premium, brand-forward landing page template specifically crafted for the luxury hospitality sector. It uses a sophisticated **dark-to-ivory** color palette and elegant typography to establish an immediate sense of exclusivity and tranquility.\n\n## Key Features\n- **Scroll-Driven Animation:** Utilizes GSAP and Lenis for seamless, cinematic transitions and parallax imagery.\n- **Cinematic Crossfades:** A bespoke 'One Day' gallery sequence that progresses as the user scrolls, perfect for visual storytelling.\n- **Dynamic WebGL Elements:** Subtle caustic water-light effects rendered in WebGL for an immersive environmental feel.\n- **Interactive Booking Form:** A clean, minimal reservation request section designed to convert high-intent visitors.\n\n## Primary Use Case\nPerfect for **private islands, luxury villas, and boutique hotel resorts** looking to showcase their property through visual-first storytelling and high-performance web interactions.","custom_domain":null,"favicon_light_url":null,"favicon_dark_url":null,"dns_verified":null,"dns_verified_at":null,"dns_a_record":null,"netlify_apex_exists":null,"netlify_www_exists":null,"netlify_verified_at":null,"custom_domain_added_at":null,"netlify_site_id":null,"umami_website_id":null,"umami_share_id":null,"analytics_enabled":false,"gtm_container_id":null,"remix_source":{},"credit_remix_source":false,"search_visibility":"aura_and_custom_domain","llms_txt":null,"llms_txt_updated_at":null,"featured_at":"2026-07-02T03:29:16.678+00:00","google_analytics_id":null,"source_revision_id":null,"published_storage_prefix":null}]