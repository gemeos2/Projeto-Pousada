.12.5/ScrollTrigger.min.js\"></script>\n<script src=\"https://unpkg.com/lenis@1.1.13/dist/lenis.min.js\"></script>\n<style>\n:root{\n--ivory:#f5f0e6; --sand:#ece2d0; --sand2:#e4d8c2; --ink:#143230; --ink2:#0c2422; --muted:#6f807c;\n--aqua:#2f8f86; --aqua2:#3fae9f; --gold:#c79a52; --line:rgba(20,50,48,.14); --lineL:rgba(245,240,230,.18);\n--disp:\"Playfair Display\",Georgia,serif; --fn:\"Inter\",system-ui,sans-serif;\n--pad:clamp(20px,5vw,84px); --max:1240px;\n}\n*{margin:0;padding:0;box-sizing:border-box}\nhtml{background:var(--ink)}\nbody{font-family:var(--fn);font-weight:300;color:var(--ink);background:var(--ivory);line-height:1.7;overflow-x:hidden;-webkit-font-smoothing:antialiased}\nimg{display:block;max-width:100%}\na{color:inherit;text-decoration:none}\n::selection{background:var(--aqua);color:#fff}\n.wrap{max-width:var(--max);margin:0 auto;padding:0 var(--pad)}\n.disp{font-family:var(--disp);font-weight:400;line-height:1.05}\n.eyebrow{font-size:.64rem;letter-spacing:.4em;text-transform:uppercase;color:var(--aqua)}\n.muted{color:var(--muted)}\n.rv{opacity:0;transform:translateY(26px)}\n.wipe{opacity:0}\nhtml.lenis,html.lenis body{height:auto}\n.lenis.lenis-smooth{scroll-behavior:auto!important}\n.lenis.lenis-stopped{overflow:hidden}\n.loader{position:fixed;inset:0;z-index:120;background:var(--ink);display:grid;place-items:center;transition:opacity .8s}\n.loader.done{opacity:0;pointer-events:none}\n.loader .mk{font-family:var(--disp);font-size:1.7rem;letter-spacing:.5em;color:var(--ivory);padding-left:.5em;position:relative}\n.loader .mk::after{content:\"\";position:absolute;left:0;right:14%;bottom:-14px;height:1px;background:var(--lineL);transform:scaleX(var(--lp,0));transform-origin:left;transition:transform .3s}\nnav{position:fixed;top:0;left:0;right:0;z-index:80;display:flex;align-items:center;justify-content:space-between;padding:1.5rem var(--pad);color:var(--ivory);transition:color .4s ease}\nnav .wm{font-family:var(--disp);font-weight:500;font-size:1.3rem;letter-spacing:.34em;padding-left:.3em;text-shadow:0 1px 3px rgba(0,0,0,.9),0 0 8px rgba(0,0,0,.75),0 0 22px rgba(0,0,0,.5)}\nnav .mn{display:flex;gap:1.8rem;font-size:.62rem;letter-spacing:.24em;text-transform:uppercase;font-weight:600}\nnav .mn a{position:relative;text-shadow:0 1px 3px rgba(0,0,0,.92),0 0 7px rgba(0,0,0,.8),0 0 16px rgba(0,0,0,.55)}\nnav .mn a::after{content:\"\";position:absolute;left:0;right:0;bottom:-5px;height:1px;background:currentColor;transform:scaleX(0);transform-origin:right;transition:transform .4s cubic-bezier(.2,.7,.2,1)}\nnav .mn a:hover::after{transform:scaleX(1);transform-origin:left}\nnav.on-light{color:var(--ink)}\nnav.on-light .wm,nav.on-light .mn a{text-shadow:none}\n@media(max-width:680px){ nav .mn{display:none} }\n/* cold open */\n.open{position:relative;height:100svh;min-height:600px;overflow:hidden;display:grid;place-items:center;text-align:center;color:#fff}\n.open .bg{position:absolute;inset:0;z-index:0}\n.open .bg img{width:100%;height:108%;object-fit:cover;object-position:center 45%}\n.open .caus{position:absolute;inset:0;z-index:1;mix-blend-mode:screen;opacity:.5;pointer-events:none}\n.open .bg::after{content:\"\";position:absolute;inset:0;z-index:2;background:radial-gradient(120% 100% at 50% 38%,transparent 38%,rgba(8,28,26,.5)),linear-gradient(180deg,rgba(8,28,26,.5),transparent 32%,rgba(8,28,26,.62))}\n.open .ct{position:relative;z-index:3;padding:0 var(--pad)}\n.open .ct .eyebrow{display:inline-flex;align-items:center;justify-content:center;gap:.95rem;margin-bottom:1.7rem;color:#fff;opacity:1;font-weight:500}\n.open .ct .eyebrow::before,.open .ct .eyebrow::after{content:\"\";width:clamp(26px,5vw,54px);height:1px;background:var(--gold);opacity:.95}\n.open h1{font-family:var(--disp);font-weight:400;font-size:clamp(3rem,10vw,8.5rem);line-height:.98}\n.open h1 .ln{display:block;overflow:hidden}\n.open h1 .ln > span{display:block}\n.open h1 em{font-style:italic}\n.open .sub{margin-top:1.5rem;font-size:clamp(.95rem,1.5vw,1.2rem);letter-spacing:.03em;opacity:.95}\n.sec{padding:clamp(6rem,13vh,11rem) 0}\n.center{text-align:center}\n.intro{text-align:center}\n.intro h2{font-family:var(--disp);font-weight:400;font-size:clamp(2rem,5vw,4rem);line-height:1.12;max-width:20ch;margin:1.2rem auto 0}\n.intro h2 em{font-style:italic;color:var(--aqua)}\n.intro p{color:var(--muted);max-width:54ch;margin:1.6rem auto 0}\n.rule{width:1px;height:64px;margin:2.6rem auto 0;background:linear-gradient(var(--aqua),transparent);transform-origin:top;transform:scaleY(0)}\n/* full-bleed cinematic moment (arrival/water/reserve) */\n.bleed{position:relative;height:100svh;min-height:560px;overflow:hidden;color:#fff}\n.bleed > img{position:absolute;inset:0;width:100%;height:120%;top:-10%;object-fit:cover;will-change:transform}\n.bleed .caus{position:absolute;inset:0;mix-blend-mode:screen;opacity:.45;pointer-events:none}\n.bleed::after{content:\"\";position:absolute;inset:0;background:linear-gradient(180deg,rgba(8,28,26,.4),transparent 34%,rgba(8,28,26,.55))}\n.bleed .cap{position:absolute;left:var(--pad);bottom:13vh;z-index:3;max-width:min(90vw,560px);text-shadow:0 1px 24px rgba(8,28,26,.45)}\n.bleed.right .cap{left:auto;right:var(--pad);text-align:right}\n.bleed .cap .k{font-size:.62rem;letter-spacing:.4em;text-transform:uppercase;color:#fff;opacity:.88;display:block;margin-bottom:.9rem}\n.bleed .cap .t{font-family:var(--disp);font-weight:400;font-size:clamp(2.2rem,5.6vw,4.2rem);line-height:1.02}\n.bleed .cap p{margin-top:1rem;max-width:38ch;opacity:.92;font-size:.98rem}\n/* split feature */\n.feat{display:grid;grid-template-columns:1.15fr .85fr;gap:clamp(2rem,5vw,4.5rem);align-items:center}\n.feat.rev{grid-template-columns:.85fr 1.15fr}\n.feat.rev .media{order:2}\n.feat .media{overflow:hidden;border-radius:2px}\n.feat .media img{width:100%;height:clamp(420px,74vh,760px);object-fit:cover;will-change:transform}\n.feat .copy .eyebrow{display:block;margin-bottom:1rem}\n.feat .copy h2{font-family:var(--disp);font-weight:400;font-size:clamp(2rem,4.4vw,3.4rem);line-height:1.04;margin-bottom:1.1rem}\n.feat .copy p{color:var(--muted);max-width:42ch;margin-bottom:1rem}\n.feat .copy .det{margin-top:1.6rem;border-top:1px solid var(--line);padding-top:1.2rem;display:flex;flex-direction:column;gap:.65rem}\n.feat .copy .det div{display:flex;justify-content:space-between;gap:1rem;font-size:.9rem}\n.feat .copy .det .l{color:var(--muted)}\n.feat .copy .det .v{font-family:var(--disp);font-size:1.1rem}\n@media(max-width:820px){ .feat,.feat.rev{grid-template-columns:1fr;gap:2rem} .feat.rev .media{order:0} .feat .media img{height:56vh} }\n/* villa types */\n.vtypes{background:var(--sand)}\n.vtypes .head{text-align:center;margin-bottom:2.8rem}\n.vtypes .head h2{font-family:var(--disp);font-weight:400;font-size:clamp(2rem,4.6vw,3.4rem);margin-top:1rem}\n.vt-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(1rem,2vw,1.6rem)}\n.vt{position:relative;overflow:hidden;border-radius:2px}\n.vt img{width:100%;height:clamp(360px,52vh,520px);object-fit:cover;transition:transform 1s cubic-bezier(.2,.7,.2,1)}\n.vt:hover img{transform:scale(1.06)}\n.vt::after{content:\"\";position:absolute;inset:0;background:linear-gradient(180deg,transparent 45%,rgba(8,28,26,.66))}\n.vt .lab{position:absolute;left:1.4rem;right:1.4rem;bottom:1.3rem;z-index:2;color:#fff}\n.vt .lab .k{font-size:.58rem;letter-spacing:.3em;text-transform:uppercase;opacity:.85;display:block;margin-bottom:.35rem}\n.vt .lab .t{display:block;font-family:var(--disp);font-size:1.5rem;line-height:1.12}\n.vt .lab .d{display:block;font-size:.82rem;opacity:.82;margin-top:.55rem;max-width:30ch;line-height:1.5}\n@media(max-width:820px){ .vt-grid{grid-template-columns:1fr} .vt img{height:54vh} }\n/* cinematic 'one day' sequence */\n.film{background:var(--ink);color:#fff}\n.film-stage{position:relative;height:100svh;min-height:560px;overflow:hidden}\n.film .frame{position:absolute;inset:0;opacity:0;will-change:opacity,transform}\n.film .frame:first-child{opacity:1}\n.film .frame img{width:100%;height:100%;object-fit:cover}\n.film-grad{position:absolute;inset:0;z-index:2;background:linear-gradient(180deg,rgba(8,28,26,.34),transparent 28%,rgba(8,28,26,.72))}\n.film-ui{position:absolute;left:var(--pad);right:var(--pad);bottom:9vh;z-index:3;display:flex;flex-direction:column;gap:1.3rem}\n.film-ey{font-size:.62rem;letter-spacing:.4em;text-transform:uppercase;color:rgba(255,255,255,.75)}\n.film-clock{display:flex;align-items:baseline;gap:1.1rem;flex-wrap:wrap}\n.film-clock .time{font-family:var(--fn);font-weight:400;font-variant-numeric:tabular-nums;font-size:.8rem;letter-spacing:.3em;color:var(--gold)}\n.film-clock .label{font-family:var(--disp);font-weight:400;font-size:clamp(2rem,5.4vw,4rem);line-height:1}\n.film-track{position:relative;height:1px;background:rgba(255,255,255,.22)}\n.film-track i{position:absolute;left:0;top:0;height:100%;width:0;background:var(--gold)}\n.film-dots{display:flex;gap:.6rem}\n.film-dots b{width:6px;height:6px;border-radius:50%;background:rgba(255,255,255,.3);transition:background .3s,transform .3s}\n.film-dots b.on{background:var(--gold);transform:scale(1.35)}\n@media (prefers-reduced-motion:reduce){\n.film-stage{height:auto;display:grid;grid-template-columns:repeat(3,1fr);gap:4px}\n.film .frame{position:relative;opacity:1!important;transform:none!important}\n.film .frame img{height:34vh}\n.film-grad,.film-ui{display:none}\n}\n@media(max-width:680px){\n.film-stage{display:grid;grid-template-columns:1fr 1fr;gap:4px;height:auto}\n.film .frame{position:relative;opacity:1!important;transform:none!important}\n.film .frame img{height:30vh}\n.film-grad,.film-ui{display:none}\n}\n/* experiences */\n.exp{background:var(--ivory)}\n.exp .head{text-align:center;margin-bottom:2.8rem}\n.exp .head h2{font-family:var(--disp);font-weight:400;font-size:clamp(2rem,4.6vw,3.4rem);margin-top:1rem}\n.exp .grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(1rem,2.5vw,1.8rem)}\n.exp figure{overflow:hidden;position:relative;border-radius:2px}\n.exp img{width:100%;height:clamp(280px,46vh,440px);object-fit:cover;transition:transform 1s cubic-bezier(.2,.7,.2,1)}\n.exp figure:hover img{transform:scale(1.06)}\n.exp figure::after{content:\"\";position:absolute;inset:0;background:linear-gradient(180deg,transparent 50%,rgba(8,28,26,.62))}\n.exp figcaption{position:absolute;left:1.5rem;bottom:1.4rem;color:#fff;z-index:2}\n.exp figcaption .k{font-size:.6rem;letter-spacing:.3em;text-transform:uppercase;opacity:.9;display:block;margin-bottom:.3rem}\n.exp figcaption .t{display:block;font-family:var(--disp);font-size:1.5rem;line-height:1.12}\n.exp figcaption .d{display:block;font-size:.82rem;opacity:.85;margin-top:.55rem;max-width:32ch;line-height:1.5}\n@media(max-width:680px){ .exp .grid{grid-template-columns:1fr} }\n/* numbers */\n.house{background:var(--sand)}\n.house .grid{display:grid;grid-template-columns:repeat(4,1fr);gap:2rem;text-align:center}\n.house .cell{padding:.5rem 0}\n.house .v{font-family:var(--disp);font-weight:400;font-size:clamp(2.4rem,5.5vw,4.2rem);color:var(--aqua);line-height:1}\n.house .l{font-size:.62rem;letter-spacing:.22em;text-transform:uppercase;color:var(--muted);margin-top:.7rem}\n@media(max-width:680px){ .house .grid{grid-template-columns:1fr 1fr;gap:2.6rem} }\n/* quote */\n.quote{background:var(--ink);color:var(--ivory);text-align:center}\n.quote .wrap{max-width:min(92vw,900px)}\n.quote .mk{color:var(--gold);font-family:var(--disp);font-size:3rem;line-height:0;display:block;margin-bottom:1.4rem;opacity:.8}\n.quote blockquote{font-family:var(--disp);font-weight:400;font-style:italic;font-size:clamp(1.5rem,3vw,2.4rem);line-height:1.3;text-wrap:balance}\n.quote blockquote .nb{white-space:nowrap}\n.quote .by{margin-top:1.8rem;font-size:.62rem;letter-spacing:.3em;text-transform:uppercase;color:rgba(245,240,230,.6)}\n/* reserve */\n.reserve{position:relative;overflow:hidden;color:#fff;text-align:center}\n.reserve > img{position:absolute;inset:0;width:100%;height:120%;top:-10%;object-fit:cover;z-index:0;will-change:transform}\n.reserve::after{content:\"\";position:absolute;inset:0;background:linear-gradient(180deg,rgba(8,28,26,.5),rgba(8,28,26,.62));z-index:1}\n.reserve .ct{position:relative;z-index:2;padding:clamp(6rem,16vh,11rem) var(--pad);max-width:760px;margin:0 auto}\n.reserve h2{font-family:var(--disp);font-weight:400;font-size:clamp(2.6rem,7vw,5.5rem);line-height:1;margin:1rem 0}\n.reserve h2 em{font-style:italic}\n.reserve p{max-width:44ch;margin:0 auto 2.2rem;opacity:.92}\n.resv{display:grid;grid-template-columns:1fr 1fr;gap:1rem;max-width:520px;margin:0 auto 1.6rem;text-align:left}\n.resv .f{display:flex;flex-direction:column;gap:.4rem}\n.resv .f.full{grid-column:1 / -1}\n.resv label{font-size:.56rem;letter-spacing:.24em;text-transform:uppercase;opacity:.8}\n.resv input{background:transparent;border:0;border-bottom:1px solid rgba(255,255,255,.4);color:#fff;padding:.6rem 0;font-family:var(--fn);font-size:.95rem;outline:none;transition:border-color .3s}\n.resv input::placeholder{color:rgba(255,255,255,.5)}\n.resv input:focus{border-color:#fff}\n.btn{display:inline-flex;align-items:center;gap:.7rem;font-size:.66rem;letter-spacing:.28em;text-transform:uppercase;border:1px solid #fff;color:#fff;padding:1.1rem 2.4rem;transition:.35s;cursor:pointer;background:transparent}\n.btn:hover{background:#fff;color:var(--ink)}\n.btn .ar{transition:transform .35s}\n.btn:hover .ar{transform:translateX(4px)}\n@media(max-width:520px){ .resv{grid-template-columns:1fr} }\n/* footer */\n.foot{background:var(--ink);color:rgba(245,240,230,.62)}\n.foot .top{display:grid;grid-template-columns:1.6fr 1fr 1fr 1.4fr;gap:2rem;padding:clamp(3.5rem,8vh,5.5rem) var(--pad) 2.4rem}\n.foot .brand .wm{font-family:var(--disp);letter-spacing:.36em;color:var(--ivory);font-size:1.3rem;display:block;margin-bottom:1rem}\n.foot .brand p{max-width:30ch;font-size:.86rem}\n.foot h4{font-size:.58rem;letter-spacing:.26em;text-transform:uppercase;color:var(--ivory);margin-bottom:1rem;opacity:.9}\n.foot ul{list-style:none;display:flex;flex-direction:column;gap:.6rem;font-size:.86rem}\n.foot ul a:hover{color:var(--ivory)}\n.foot .news input{background:transparent;border:0;border-bottom:1px solid var(--lineL);color:var(--ivory);padding:.5rem 0;width:100%;font-family:var(--fn);outline:none;font-size:.9rem}\n.foot .news button{margin-top:.9rem;background:transparent;border:1px solid var(--lineL);color:var(--ivory);padding:.7rem 1.4rem;font-size:.58rem;letter-spacing:.24em;text-transform:uppercase;cursor:pointer;transition:.3s}\n.foot .news button:hover{background:var(--ivory);color:var(--ink);border-color:var(--ivory)}\n.foot .bot{border-top:1px solid var(--lineL);padding:1.5rem var(--pad);display:flex;justify-content:space-between;flex-wrap:wrap;gap:1rem;font-size:.6rem;letter-spacing:.18em;text-transform:uppercase}\n@media(max-width:820px){ .foot .top{grid-template-columns:1fr 1fr} }\n@media(max-width:520px){ .foot .top{grid-template-columns:1fr} }\n@media (prefers-reduced-motion:reduce){\n.rv,.wipe{opacity:1!important;transform:none!important}\n.rule{transform:scaleY(1)!important}\n.bleed > img,.reserve > img,.feat .media img{transform:none!important}\n}\n</style>\n<script src=\"https://cdn.tailwindcss.com\"></script><!-- aura-ga4-start -->\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-2M6V79H761\"></script>\n<script>\nwindow.dataLayer = window.dataLayer || [];\nfunction gtag(){dataLayer.push(arguments);}\ngtag('js', new Date());\ngtag('config', 'G-2M6V79H761');\n</script>\n<!-- aura-ga4-end -->\n</head>\n<body>\n<div class=\"loader\" id=\"loader\"><div class=\"mk\">SERENE</div></div>\n\n<nav>\n  <div class=\"wm\">SERENE</div>\n  <div class=\"mn\"><a href=\"#villa\">The Villas</a><a href=\"#exp\">Experiences</a><a href=\"#gallery\">Gallery</a><a href=\"#reserve\">Reserve</a></div>\n</nav>\n\n<!-- COLD OPEN -->\n<header class=\"open\">\n  <div class=\"bg\"><img src=\"https://cdn.jsdelivr.net/gh/VanhDc/aura-assets@atoll-v2/atoll/img/aerial-hero.jpg\" alt=\"SERENE private island from the air\" decoding=\"async\"></div>\n  <canvas class=\"caus\" id=\"causHero\"></canvas>\n  <div class=\"ct\">\n    <span class=\"eyebrow\">A private island</span>\n    <h1><span class=\"ln\"><span>Nowhere,</span></span><span class=\"ln\"><span><em>perfected.</em></span></span></h1>\n    <div class=\"sub\">Twelve villas. One island. No one else.</div>\n  </div>\n</header>\n\n<!-- INTRO -->\n<section class=\"sec intro\"><div class=\"wrap\">\n  <span class=\"eyebrow rv\">The island</span>\n  <h2 class=\"disp wipe\">An island at the <em>end of the map.</em></h2>\n  <p class=\"rv\">Forty-seven acres of palm and white sand, ringed by a private reef. A single resort of twelve overwater villas, reached only by seaplane. Here the day has no schedule but the tide.</p>\n  <div class=\"rule\" id=\"introRule\"></div>\n</div></section>\n\n<!-- ARRIVAL -->\n<section class=\"bleed\" id=\"arrival\">\n  <img src=\"https://cdn.jsdelivr.net/gh/VanhDc/aura-assets@atoll-v2/atoll/img/seaplane.jpg\" alt=\"A seaplane arriving at the island\" class=\"par\" loading=\"lazy\" decoding=\"async\">\n  <div class=\"cap rv\"><span class=\"k\">The arrival</span><span class=\"t disp\">An hour from the world,<br>and then gone from it.</span><p>A single seaplane crosses the lagoon at golden hour. From the float to your deck is forty steps. There is no road, no lobby, no one waiting but the sea.</p></div>\n</section>\n\n<!-- THE VILLA -->\n<section class=\"sec\" id=\"villa\" style=\"padding-bottom:clamp(4rem,9vh,7rem)\"><div class=\"wrap feat\">\n  <div class=\"media rv\"><img src=\"https://cdn.jsdelivr.net/gh/VanhDc/aura-assets@atoll-v2/atoll/img/suite-interior.jpg\" alt=\"An overwater villa suite\" class=\"par\" loading=\"lazy\" decoding=\"async\"></div>\n  <div class=\"copy\">\n    <span class=\"eyebrow rv\">The villas</span>\n    <h2 class=\"disp wipe\">A room that opens<br>to the sea</h2>\n    <p class=\"rv\">Each villa stands alone over the lagoon, glass walls folding away to a private deck and steps straight into the water. Natural wood, stone and linen, cooled by the trade wind.</p>\n    <div class=\"det rv\">\n      <div><span class=\"l\">Villas</span><span class=\"v\">12, overwater</span></div>\n      <div><span class=\"l\">Living space</span><span class=\"v\">From 220 m2</span></div>\n      <div><span class=\"l\">Access</span><span class=\"v\">Seaplane, 40 min</span></div>\n    </div>\n  </div>\n</div></section>\n\n<!-- VILLA TYPES -->\n<section class=\"sec vtypes\"><div class=\"wrap\">\n  <div class=\"head\"><span class=\"eyebrow rv\">Choose your water</span><h2 class=\"disp wipe\">Three ways to stay</h2></div>\n  <div class=\"vt-grid\">\n    <div class=\"vt rv\"><img src=\"https://cdn.jsdelivr.net/gh/VanhDc/aura-assets@atoll-v2/atoll/img/infinity-pool.jpg\" alt=\"Pool villa\" loading=\"lazy\" decoding=\"async\"><div class=\"lab\"><span class=\"k\">01</span><span class=\"t\">The Pool Villa</span><span class=\"d\">A private infinity pool that spills into the lagoon.</span></div></div>\n    <div class=\"vt rv\"><img src=\"https://cdn.jsdelivr.net/gh/VanhDc/aura-assets@atoll-v2/atoll/img/hammock.jpg\" alt=\"Lagoon villa\" loading=\"lazy\" decoding=\"async\"><div class=\"lab\"><span class=\"k\">02</span><span class=\"t\">The Lagoon Villa</span><span class=\"d\">Hammock over glass-clear water, steps to the reef.</span></div></div>\n    <div class=\"vt rv\"><img src=\"https://cdn.jsdelivr.net/gh/VanhDc/aura-assets@atoll-v2/atoll/img/night.jpg\" alt=\"Sunset villa\" loading=\"lazy\" decoding=\"async\"><div class=\"lab\"><span class=\"k\">03</span><span class=\"t\">The Sunset Villa</span><span class=\"d\">The far point of the island, kept for the stars.</span></div></div>\n  </div>\n</div></section>\n\n<!-- THE WATER (full bleed) -->\n<section class=\"bleed\" id=\"water\">\n  <img src=\"https://cdn.jsdelivr.net/gh/VanhDc/aura-assets@atoll-v2/atoll/img/infinity-pool.jpg\" alt=\"Private infinity pool over the lagoon\" class=\"par\" loading=\"lazy\" decoding=\"async\">\n  <canvas class=\"caus\" id=\"causWater\"></canvas>\n  <div class=\"cap rv\"><span class=\"k\">Your own horizon</span><span class=\"t disp\">A pool that ends<br>where the ocean begins.</span></div>\n</section>\n\n<!-- REEF -->\n<section class=\"sec\" id=\"reef\"><div class=\"wrap feat rev\">\n  <div class=\"media rv\"><img src=\"https://cdn.jsdelivr.net/gh/VanhDc/aura-assets@atoll-v2/atoll/img/reef.jpg\" alt=\"The house reef\" class=\"par\" loading=\"lazy\" decoding=\"async\"></div>\n  <div class=\"copy\">\n    <span class=\"eyebrow rv\">The house reef</span>\n    <h2 class=\"disp wipe\">A garden, just<br>beneath the surface</h2>\n    <p class=\"rv\">Slip off your deck into a living reef of coral and colour. Turtles drift the drop-off at dawn; the lagoon keeps the water still and warm and impossibly clear.</p>\n    <div class=\"det rv\">\n      <div><span class=\"l\">Reef</span><span class=\"v\">Private, house</span></div>\n      <div><span class=\"l\">Visibility</span><span class=\"v\">To 30 m</span></div>\n      <div><span class=\"l\">Water</span><span class=\"v\">28°C, year-round</span></div>\n    </div>\n  </div>\n</div></section>\n\n<!-- A DAY (cinematic crossfade sequence) -->\n<section class=\"film\" id=\"gallery\">\n  <div class=\"film-stage\">\n    <div class=\"frame\"><img src=\"https://cdn.jsdelivr.net/gh/VanhDc/aura-assets@atoll-v2/atoll/img/aerial-hero.jpg\" alt=\"First light over the island\" decoding=\"async\"></div>\n    <div class=\"frame\"><img src=\"https://cdn.jsdelivr.net/gh/VanhDc/aura-assets@atoll-v2/atoll/img/hammock.jpg\" alt=\"Midday over the lagoon\" loading=\"lazy\" decoding=\"async\"></div>\n    <div class=\"frame\"><img src=\"https://cdn.jsdelivr.net/gh/VanhDc/aura-assets@atoll-v2/atoll/img/reef.jpg\" alt=\"Beneath the surface\" loading=\"lazy\" decoding=\"async\"></div>\n    <div class=\"frame\"><img src=\"https://cdn.jsdelivr.net/gh/VanhDc/aura-assets@atoll-v2/atoll/img/dining.jpg\" alt=\"The blue hour\" loading=\"lazy\" decoding=\"async\"></div>\n    <div class=\"frame\"><img src=\"https://cdn.jsdelivr.net/gh/VanhDc/aura-assets@atoll-v2/atoll/img/beach-dusk.jpg\" alt=\"Sundown\" loading=\"lazy\" decoding=\"async\"></div>\n    <div class=\"frame\"><img src=\"https://cdn.jsdelivr.net/gh/VanhDc/aura-assets@atoll-v2/atoll/img/night.jpg\" alt=\"And then, stars\" loading=\"lazy\" decoding=\"async\"></div>\n    <div class=\"film-grad\"></div>\n    <div class=\"film-ui\">\n      <span class=\"film-ey\">A day, in passing</span>\n      <div class=\"film-clock\"><span class=\"time\">06:00</span><span class=\"label disp\">First light</span></div>\n      <div class=\"film-track\"><i id=\"filmProg\"></i></div>\n      <div class=\"film-dots\"><b class=\"on\"></b><b></b><b></b><b></b><b></b><b></b></div>\n    </div>\n  </div>\n</section>\n\n<!-- EXPERIENCES -->\n<section class=\"sec exp\" id=\"exp\"><div class=\"wrap\">\n  <div class=\"head\"><span class=\"eyebrow rv\">Experiences</span><h2 class=\"disp wipe\">Days made of small perfect things</h2></div>\n  <div class=\"grid\">\n    <figure class=\"rv\"><img src=\"https://cdn.jsdelivr.net/gh/VanhDc/aura-assets@atoll-v2/atoll/img/dining.jpg\" alt=\"Overwater private dining\" loading=\"lazy\" decoding=\"async\"><figcaption><span class=\"k\">Dining</span><span class=\"t\">A table on the water</span><span class=\"d\">A chef, a lantern-lit deck, and the tide for company.</span></figcaption></figure>\n    <figure class=\"rv\"><img src=\"https://cdn.jsdelivr.net/gh/VanhDc/aura-assets@atoll-v2/atoll/img/spa.jpg\" alt=\"Overwater spa\" loading=\"lazy\" decoding=\"async\"><figcaption><span class=\"k\">Wellness</span><span class=\"t\">The overwater spa</span><span class=\"d\">Treatments above the lagoon, scored by water.</span></figcaption></figure>\n    <figure class=\"rv\"><img src=\"https://cdn.jsdelivr.net/gh/VanhDc/aura-assets@atoll-v2/atoll/img/reef.jpg\" alt=\"Diving the reef\" loading=\"lazy\" decoding=\"async\"><figcaption><span class=\"k\">The water</span><span class=\"t\">Dive the house reef</span><span class=\"d\">Guided from your deck, or alone at first light.</span></figcaption></figure>\n    <figure class=\"rv\"><img src=\"https://cdn.jsdelivr.net/gh/VanhDc/aura-assets@atoll-v2/atoll/img/beach-dusk.jpg\" alt=\"The shore at dusk\" loading=\"lazy\" decoding=\"async\"><figcaption><span class=\"k\">The shore</span><span class=\"t\">Sunset, kept for you</span><span class=\"d\">A lantern, two chairs, and no one for a mile.</span></figcaption></figure>\n  </div>\n</div></section>\n\n<!-- NUMBERS -->\n<section class=\"sec house\"><div class=\"wrap\"><div class=\"grid\">\n  <div class=\"cell rv\"><div class=\"v disp num\" data-count=\"12\"></div><div class=\"l\">Overwater villas</div></div>\n  <div class=\"cell rv\"><div class=\"v disp num\" data-count=\"47\"></div><div class=\"l\">Private acres</div></div>\n  <div class=\"cell rv\"><div class=\"v disp\">5:1</div><div class=\"l\">Staff to guest</div></div>\n  <div class=\"cell rv\"><div class=\"v disp num\" data-count=\"1\"></div><div class=\"l\">Island, entirely</div></div>\n</div></div></section>\n\n<!-- QUOTE -->\n<section class=\"sec quote\"><div class=\"wrap\">\n  <span class=\"mk disp\">“</span>\n  <blockquote class=\"wipe\">We have travelled everywhere. This is the only place we have ever truly arrived.</blockquote>\n  <div class=\"by rv\">Travel + Leisure · Reader's choice</div>\n</div></section>\n\n<!-- RESERVE -->\n<section class=\"reserve\" id=\"reserve\">\n  <img src=\"https://cdn.jsdelivr.net/gh/VanhDc/aura-assets@atoll-v2/atoll/img/night.jpg\" alt=\"SERENE at night\" class=\"par\" loading=\"lazy\" decoding=\"async\">\n  <div class=\"ct\">\n    <span class=\"eyebrow\" style=\"color:#fff;opacity:.9\">Reserve</span>\n    <h2 class=\"disp wipe\">The island is <em>yours.</em></h2>\n    <p>We take a single party at a time on request, or one villa among few. Tell us your dates and we will hold the tide.</p>\n    <form class=\"resv\" onsubmit=\"return false\">\n      <div class=\"f\"><label>Arrive</label><input type=\"text\" placeholder=\"Add dates\" aria-label=\"Arrival date\"></div>\n      <div class=\"f\"><label>Depart</label><input type=\"text\" placeholder=\"Add dates\" aria-label=\"Departure date\"></div>\n      <div class=\"f\"><label>Guests</label><input type=\"text\" placeholder=\"2 adults\" aria-label=\"Guests\"></div>\n      <div class=\"f\"><label>Villa</label><input type=\"text\" placeholder=\"Pool villa\" aria-label=\"Villa\"></div>\n      <div class=\"f full\"><label>Email</label><input type=\"email\" placeholder=\"you@elsewhere.com\" aria-label=\"Email\"></div>\n    </form>\n    <a href=\"#reserve\" class=\"btn\">Request a stay <span class=\"ar\">→</span></a>\n  </div>\n</section>\n\n<footer class=\"foot\">\n  <div class=\"top\">\n    <div class=\"brand\"><span class=\"wm\">SERENE</span><p>A private island in the Indian Ocean. Twelve overwater villas, one reef, nowhere else.</p></div>\n    <div><h4>Explore</h4><ul><li><a href=\"#villa\">The Villas</a></li><li><a href=\"#reef\">The Reef</a></li><li><a href=\"#exp\">Experiences</a></li><li><a href=\"#gallery\">Gallery</a></li></ul></div>\n    <div><h4>Visit</h4><ul><li><a href=\"#arrival\">Getting here</a></li><li><a href=\"#reef\">The reef</a></li><li><a href=\"#reserve\">Reserve</a></li><li><a href=\"#reserve\">Private buyout</a></li></ul></div>\n    <div class=\"news\"><h4>The tide letter</h4><p style=\"font-size:.84rem;margin-bottom:1rem\">Word from the island, a few times a year.</p>\n      <form onsubmit=\"return false\"><input type=\"email\" placeholder=\"you@elsewhere.com\" aria-label=\"Email\"><button type=\"submit\">Subscribe</button></form>\n    </div>\n  </div>\n  <div class=\"bot\"><span>© 2026 Serene Island · Nowhere, perfected.</span><span>By seaplane, on request</span></div>\n</footer>\n\n<script>\n(function(){\n  const RM = matchMedia('(prefers-reduced-